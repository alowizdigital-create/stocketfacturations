msgid "Paramètres régionaux — {{ name }}"
msgstr "Regional settings — {{ name }}"

msgid ""
"Pour que l'application fonctionne correctement quel que soit le pays : la "
"devise s'affiche partout (factures, devis, POS), et l'indicatif téléphonique"
" complète automatiquement les numéros WhatsApp saisis sans code pays (ex: "
"<code>07 12 34 56 78</code> → <code>+225 07 12 34 56 78</code>)."
