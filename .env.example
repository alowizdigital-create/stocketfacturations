# Copier ce fichier en `.env` sur le serveur et remplacer les valeurs.
# Ne jamais committer le fichier `.env` réel (déjà exclu par .gitignore).

# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-a-real-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=zweey.com,www.zweey.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://zweey.com,https://www.zweey.com
DJANGO_TIME_ZONE=Africa/Abidjan
DEFAULT_TVA_RATE=18.0

# --- Base de données MySQL (lue par config/settings/online.py) ---
DB_NAME=zweeydb
DB_USER=zweeyuser
DB_PASSWORD=change-me-strong-password
DB_HOST=stocketfacturation-zweeydatabase-pss441
DB_PORT=3306

# --- Email (mot de passe oublié) ---
# Sans ces variables, les emails s'affichent seulement dans les logs du
# conteneur (backend console) au lieu d'être réellement envoyés.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@zweey.com

# --- API WhatsApp (techsoft-sms.com) ---
# À corriger dans apps/sales/whatsapp_api.py si les noms de paramètres ou
# l'URL de l'endpoint diffèrent de la documentation réelle du compte.
TECHSOFT_API_KEY=
TECHSOFT_WHATSAPP_API_URL=https://app.techsoft-sms.com/whatsapp/api
TECHSOFT_WHATSAPP_SENDER=
